  components   FeeComponent[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, academicYearId])
  @@map("fee_structures")
}

model FeeComponent {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feeStructureId String  @map("fee_structure_id") @db.Uuid
  name           String  @db.VarChar(128)
