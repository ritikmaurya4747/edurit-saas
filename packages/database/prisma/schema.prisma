  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("compliance_records")
}

model Notice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String    @db.VarChar(255)
  content     String    @db.Text
  targetRole  String    @default("ALL") @map("target_role") @db.VarChar(32)
  priority    String    @default("INFO") @db.VarChar(16)
  status      String    @default("PUBLISHED") @db.VarChar(16)
  createdById String?   @map("created_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  publishedAt DateTime  @default(now()) @map("published_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notices")
}

model MarketplaceItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  sellerContact String    @map("seller_contact") @db.VarChar(64)
  isAvailable   Boolean   @default(true) @map("is_available")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("marketplace_items")
}

