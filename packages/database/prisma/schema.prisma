model TenantAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityName String   @map("entity_name") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Uuid
  changes    Json     @default("{}") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityName, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("tenant_audit_logs")
}

// ============================================================================
// 13. HR EXTENSIONS: STAFF LEAVE, STAFF ATTENDANCE & APPRAISALS
// ============================================================================

model StaffLeave {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  staffId      String      @map("staff_id") @db.Uuid
  leaveType    String      @map("leave_type") @db.VarChar(32)
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  actionReason String?     @map("action_reason") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, staffId])
  @@index([tenantId, status])
  @@map("staff_leaves")
}

model StaffAttendance {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  staffId        String           @map("staff_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in") @db.Timestamptz
  checkOut       DateTime?        @map("check_out") @db.Timestamptz
  status         AttendanceStatus @default(PRESENT)
  remarks        String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, staffId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@map("staff_attendance")
}

model StaffAppraisal {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  period     String    @db.VarChar(32)
  rating     Decimal?  @db.Decimal(3, 1)
  remarks    String?   @db.Text
  status     String    @default("PENDING") @db.VarChar(16)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, staffId, period])
  @@index([tenantId])
  @@map("staff_appraisals")
}

// ============================================================================
// 14. ADMISSIONS PIPELINE
// ============================================================================

enum AdmissionStage {
  ENQUIRY
  DOCUMENT_VERIFICATION
  ENTRANCE_TEST
  OFFER_SENT
  ADMITTED
  WAITLISTED
  REJECTED
}

model AdmissionEnquiry {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  studentName  String         @map("student_name") @db.VarChar(255)
  parentName   String?        @map("parent_name") @db.VarChar(255)
  phone        String         @db.VarChar(32)
  email        String?        @db.VarChar(255)
  dob          DateTime?      @db.Date
  gender       String?        @db.VarChar(16)
  classApplied String         @map("class_applied") @db.VarChar(64)
  source       String         @default("WALK_IN") @db.VarChar(32)
  stage        AdmissionStage @default(ENQUIRY)
  testDate     DateTime?      @map("test_date") @db.Timestamptz
  testScore    Decimal?       @map("test_score") @db.Decimal(5, 2)
  notes        String?        @db.Text
  studentId    String?        @map("student_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
  @@map("admission_enquiries")
}

// ============================================================================
// 15. EXAM SEATING (DESK SLIPS)
// ============================================================================

model ExamSeat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  examId     String   @map("exam_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  roomNumber String   @map("room_number") @db.VarChar(32)
  seatNumber String   @map("seat_number") @db.VarChar(16)
  status     String   @default("GENERATED") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@unique([examId, roomNumber, seatNumber])
  @@index([tenantId, examId])
  @@map("exam_seats")
}

// ============================================================================
// 16. ACADEMIC CALENDAR (HOLIDAYS & EVENTS)
// ============================================================================

enum CalendarEventType {
  HOLIDAY
  EVENT
  EXAM
  PTM
  ACTIVITY
  OTHER
}

model CalendarEvent {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  title       String            @db.VarChar(255)
  description String?           @db.Text
  type        CalendarEventType @default(EVENT)
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime          @map("end_date") @db.Date
  isHoliday   Boolean           @default(false) @map("is_holiday")
  targetRole  String            @default("ALL") @map("target_role") @db.VarChar(32)
  createdById String?           @map("created_by_id") @db.Uuid
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("calendar_events")
}

// ============================================================================
// 17. TRANSPORT
// ============================================================================

model Vehicle {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  registrationNumber String    @map("registration_number") @db.VarChar(32)
  model              String?   @db.VarChar(128)
  capacity           Int
  driverName         String    @map("driver_name") @db.VarChar(128)
  driverPhone        String    @map("driver_phone") @db.VarChar(32)
  driverLicense      String?   @map("driver_license") @db.VarChar(64)
  helperName         String?   @map("helper_name") @db.VarChar(128)
  helperPhone        String?   @map("helper_phone") @db.VarChar(32)
  insuranceExpiry    DateTime? @map("insurance_expiry") @db.Date
  fitnessExpiry      DateTime? @map("fitness_expiry") @db.Date
  isActive           Boolean   @default(true) @map("is_active")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes TransportRoute[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@map("vehicles")
}

model TransportRoute {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(128)
  code       String    @db.VarChar(32)
  vehicleId  String?   @map("vehicle_id") @db.Uuid
  monthlyFee Decimal   @default(0.00) @map("monthly_fee") @db.Decimal(10, 2)
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops       RouteStop[]
  assignments StudentTransport[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("transport_routes")
}

model RouteStop {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  name       String   @db.VarChar(128)
  sequence   Int
  pickupTime String?  @map("pickup_time") @db.VarChar(8)
  dropTime   String?  @map("drop_time") @db.VarChar(8)
  fee        Decimal? @db.Decimal(10, 2)

  route       TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransport[]

  @@index([routeId])
  @@map("route_stops")
}

model StudentTransport {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  routeId   String    @map("route_id") @db.Uuid
  stopId    String?   @map("stop_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    RouteStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([tenantId, routeId])
  @@index([tenantId, studentId])
  @@map("student_transport")
}

// ============================================================================
// 18. LIBRARY
// ============================================================================

model LibraryBook {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  isbn            String?   @db.VarChar(32)
  title           String    @db.VarChar(255)
  author          String?   @db.VarChar(255)
  publisher       String?   @db.VarChar(255)
  category        String?   @db.VarChar(64)
  shelfLocation   String?   @map("shelf_location") @db.VarChar(32)
  totalCopies     Int       @default(1) @map("total_copies")
  availableCopies Int       @default(1) @map("available_copies")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues BookIssue[]

  @@index([tenantId])
  @@map("library_books")
}

model BookIssue {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  studentId  String?   @map("student_id") @db.Uuid
  staffId    String?   @map("staff_id") @db.Uuid
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  dueDate    DateTime  @map("due_date") @db.Date
  returnedAt DateTime? @map("returned_at") @db.Timestamptz
  fineAmount Decimal   @default(0.00) @map("fine_amount") @db.Decimal(10, 2)
  finePaid   Boolean   @default(false) @map("fine_paid")
  remarks    String?   @db.Text
  issuedById String?   @map("issued_by_id") @db.Uuid

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff   Staff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookId])
  @@index([tenantId, returnedAt])
  @@index([studentId])
  @@map("book_issues")
}

// ============================================================================
// 19. CERTIFICATES & ID CARDS (issue register)
// ============================================================================

model IssuedCertificate {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  type         String    @db.VarChar(32)
  serialNumber String    @map("serial_number") @db.VarChar(64)
  data         Json      @default("{}") @db.JsonB
  issuedById   String?   @map("issued_by_id") @db.Uuid
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, type])
  @@map("issued_certificates")
}
