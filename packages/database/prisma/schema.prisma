// ============================================================================
// 5. ATTENDANCE & LEAVE MANAGEMENT
// ============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  attendanceDate DateTime @map("attendance_date") @db.Date
  periodNumber   Int      @default(0) @map("period_number") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section              @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  staff     Staff                @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  records   AttendanceRecord[]
  qrSession AttendanceQrSession?

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, attendanceDate, periodNumber])
  @@index([tenantId, sectionId, attendanceDate])
  @@index([tenantId, staffId])
  @@map("attendance_sessions")
}

model AttendanceQrSession {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceSessionId String   @unique @map("attendance_session_id") @db.Uuid
  tokenHash           String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz
  maxScans            Int?     @map("max_scans")
  isRevoked           Boolean  @default(false) @map("is_revoked")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  session  AttendanceSession     @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  attempts AttendanceQrAttempt[]

  @@map("attendance_qr_sessions")
}

model AttendanceQrAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrSessionId String   @map("qr_session_id") @db.Uuid
  studentId   String?  @map("student_id") @db.Uuid
  isSuccess   Boolean  @map("is_success")
  failureCode String?  @map("failure_code") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  scannedAt   DateTime @default(now()) @map("scanned_at") @db.Timestamptz

  qrSession AttendanceQrSession @relation(fields: [qrSessionId], references: [id], onDelete: Cascade)

  @@index([qrSessionId])
  @@map("attendance_qr_attempts")
}

model AttendanceRecord {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus @default(PRESENT)
  remarks   String?          @db.Text
  markedAt  DateTime         @default(now()) @map("marked_at") @db.Timestamptz

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model StudentLeave {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  studentId    String      @map("student_id") @db.Uuid
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  actionReason String?     @map("action_reason") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("student_leaves")
}

