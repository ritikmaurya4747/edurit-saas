  feeStructure FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoiceItems StudentInvoiceItem[]

  @@index([feeStructureId])
  @@map("fee_components")
}

model StudentInvoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(64)
  currency       String        @default("INR") @db.VarChar(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount  Decimal       @map("balance_amount") @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  version        Int           @default(1)
  dueDate        DateTime      @map("due_date") @db.Date
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear           @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  student      Student                @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  items        StudentInvoiceItem[]
  allocations  FeePaymentAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
  @@map("student_invoices")
}

model StudentInvoiceItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  feeComponentId String? @map("fee_component_id") @db.Uuid
  title          String  @db.VarChar(128)
  unitAmount     Decimal @map("unit_amount") @db.Decimal(12, 2)
  quantity       Int     @default(1)
  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  invoice      StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeComponent FeeComponent?  @relation(fields: [feeComponentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("student_invoice_items")
}

model FeePayment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(255)
  receiptNumber  String?  @map("receipt_number") @db.VarChar(64)
  amount         Decimal  @db.Decimal(12, 2)
  paymentMethod  String   @map("payment_method") @db.VarChar(32)
  gatewayRef     String?  @map("gateway_ref") @db.VarChar(128)
  remarks        String?  @db.Text
  collectedById  String?  @map("collected_by_id") @db.Uuid
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  allocations FeePaymentAllocation[]
  refunds     FeeRefund[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@map("fee_payments")
}

model FeePaymentAllocation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
  allocatedAt     DateTime @default(now()) @map("allocated_at") @db.Timestamptz

  payment FeePayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("fee_payment_allocations")
}

model FeeRefund {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   @db.Text
  status      String   @default("COMPLETED") @db.VarChar(32)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("fee_refunds")
}

