datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ============================================================================
// 0. PLATFORM CONTROL PLANE & AUDITING
// ============================================================================

enum PlatformRole {
  SUPER_ADMIN
  TECH_SUPPORT
  BILLING_ADMIN
  COMPLIANCE_OFFICER
}

model PlatformUser {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String       @unique @db.VarChar(255)
  passwordHash        String       @map("password_hash") @db.VarChar(255)
  firstName           String       @map("first_name") @db.VarChar(128)
  lastName            String       @map("last_name") @db.VarChar(128)
  role                PlatformRole @default(SUPER_ADMIN)
  permissionsJson     Json         @default("[]") @map("permissions_json") @db.JsonB
  isActive            Boolean      @default(true) @map("is_active")
  lastLoginAt         DateTime?    @map("last_login_at") @db.Timestamptz
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  refreshTokenHash    String?      @map("refresh_token_hash") @db.VarChar(255)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  platformAuditLogs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  action         String   @db.VarChar(64)
  entityName     String   @map("entity_name") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.Uuid
  changes        Json     @default("{}") @db.JsonB
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([platformUserId])
  @@index([targetTenantId])
  @@index([entityName, entityId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ============================================================================
// 1. PLATFORM, SUBSCRIPTIONS & MULTI-TENANCY CORE
// ============================================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model SubscriptionPlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(128)
  maxStudents  Int      @map("max_students")
  maxStaff     Int      @map("max_staff")
  pricePerYear Decimal  @map("price_per_year") @db.Decimal(12, 2)
  featuresJson Json     @default("{}") @map("features_json") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenantSubscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(255)
  legalName String?      @map("legal_name") @db.VarChar(255)
  status    TenantStatus @default(ACTIVE)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  settings           TenantSettings?
  subscriptions      TenantSubscription[]
  branches           Branch[]
  memberships        Membership[]
  roles              Role[]
  academicYears      AcademicYear[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  staff              Staff[]
  students           Student[]
  parents            Parent[]
  invitations        UserInvitation[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  studentLeaves      StudentLeave[]
  homeworks          Homework[]
  exams              Exam[]
  onlineExams        OnlineExam[]
  reportCards        ReportCard[]
  feeStructures      FeeStructure[]
  studentInvoices    StudentInvoice[]
  feePayments        FeePayment[]
  payrollRecords     PayrollRecord[]
  visitors           Visitor[]
  infirmaryVisits    InfirmaryVisit[]
  inventoryItems     InventoryItem[]
  complianceRecords  ComplianceRecord[]
  notices            Notice[]
  marketplaceItems   MarketplaceItem[]
  auditLogs          TenantAuditLog[]
  studentEnrollments StudentEnrollment[]
  files              File[]
  staffLeaves        StaffLeave[]
  staffAttendances   StaffAttendance[]
  staffAppraisals    StaffAppraisal[]
  admissionEnquiries AdmissionEnquiry[]
  examSeats          ExamSeat[]
  calendarEvents     CalendarEvent[]
  vehicles           Vehicle[]
  transportRoutes    TransportRoute[]
  studentTransports  StudentTransport[]
  libraryBooks       LibraryBook[]
  bookIssues         BookIssue[]
  certificates       IssuedCertificate[]

  @@map("tenants")
}

model TenantSubscription {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @map("start_date") @db.Timestamptz
  endDate   DateTime           @map("end_date") @db.Timestamptz
  autoRenew Boolean            @default(true) @map("auto_renew")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([planId])
  @@map("tenant_subscriptions")
}

model TenantSettings {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  currency     String   @default("INR") @db.VarChar(3)
  timezone     String   @default("Asia/Kolkata") @db.VarChar(64)
  customDomain String?  @unique @map("custom_domain") @db.VarChar(255)
  logoUrl      String?  @map("logo_url") @db.Text
  themeConfig  Json     @default("{}") @map("theme_config") @db.JsonB
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(32)
  address   Json?     @default("{}") @db.JsonB
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes  Class[]
  staff    Staff[]
  students Student[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ============================================================================
// 2. IDENTITY, AUTHENTICATION & RBAC
// ============================================================================

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(128)
  lastName     String    @map("last_name") @db.VarChar(128)
  avatarUrl    String?   @map("avatar_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  memberships             Membership[]
  staffProfiles           Staff[]
  students                Student[]
  parents                 Parent[]
  auditLogs               TenantAuditLog[]
  uploadedFiles           File[]
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([phone])
  @@map("users")
}

model UserSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userAgent    String?  @map("user_agent") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model Role {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(64)
  code     String  @db.VarChar(64)
  isSystem Boolean @default(false) @map("is_system")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(128)
  module      String  @db.VarChar(64)
  description String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

model UserInvitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  email      String   @db.VarChar(255)
  phone      String?  @db.VarChar(32)
  roleCode   String   @map("role_code") @db.VarChar(64)
  token      String   @unique @db.VarChar(255)
  metadata   Json     @default("{}") @db.JsonB
  isAccepted Boolean  @default(false) @map("is_accepted")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, token])
  @@map("user_invitations")
}

// ============================================================================
// 3. ACADEMIC STRUCTURE & TIMETABLE
// ============================================================================

model AcademicYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(64)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments     StudentEnrollment[]
  timetables      Timetable[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  studentInvoices StudentInvoice[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("academic_years")
}

model Class {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String    @db.VarChar(64)
  code      String    @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  sections Section[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, code])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("classes")
}

model Section {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String    @db.VarChar(64)
  capacity  Int       @default(40)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Cascade)
  enrollments        StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]

  @@unique([tenantId, id])
  @@unique([tenantId, classId, name])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@map("sections")
}

model Subject {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(128)
  code      String    @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables   Timetable[]
  examSubjects ExamSubject[]
  homeworks    Homework[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

model Timetable {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  sectionId      String  @map("section_id") @db.Uuid
  subjectId      String  @map("subject_id") @db.Uuid
  staffId        String  @map("staff_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") @db.SmallInt
  periodNumber   Int     @map("period_number") @db.SmallInt
  startTime      String  @map("start_time") @db.VarChar(8)
  endTime        String  @map("end_time") @db.VarChar(8)
  roomNumber     String? @map("room_number") @db.VarChar(32)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  section      Section      @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  subject      Subject      @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)
  staff        Staff        @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, sectionId, dayOfWeek, periodNumber])
  @@unique([tenantId, academicYearId, staffId, dayOfWeek, periodNumber])
  @@index([tenantId, staffId, dayOfWeek, periodNumber])
  @@index([tenantId, sectionId, dayOfWeek, periodNumber])
  @@index([tenantId, subjectId])
  @@map("timetables")
}

// ============================================================================
// 4. PEOPLE: STAFF, STUDENTS, PARENTS & PROFILES
// ============================================================================

enum StudentStatus {
  ACTIVE
  ALUMNI
  TRANSFERRED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

model Staff {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  employeeCode    String      @map("employee_code") @db.VarChar(64)
  isTeachingStaff Boolean     @default(true) @map("is_teaching_staff")
  specialization  String?     @db.VarChar(128)
  designation     String?     @db.VarChar(128)
  department      String?     @db.VarChar(128)
  joiningDate     DateTime?   @map("joining_date") @db.Date
  basicSalary     Decimal     @default(0.00) @map("basic_salary") @db.Decimal(12, 2)
  status          StaffStatus @default(ACTIVE)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  homeworks          Homework[]
  payrollRecords     PayrollRecord[]
  leaves             StaffLeave[]
  attendances        StaffAttendance[]
  appraisals         StaffAppraisal[]
  bookIssues         BookIssue[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("staff")
}

model Student {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  admissionNumber String        @map("admission_number") @db.VarChar(64)
  firstName       String        @default("") @map("first_name") @db.VarChar(128)
  lastName        String        @default("") @map("last_name") @db.VarChar(128)
  dob             DateTime      @db.Date
  gender          String        @db.VarChar(16)
  bloodGroup      String?       @map("blood_group") @db.VarChar(8)
  phone           String?       @db.VarChar(32)
  email           String?       @db.VarChar(255)
  address         String?       @db.Text
  photoUrl        String?       @map("photo_url") @db.Text
  admissionDate   DateTime      @default(now()) @map("admission_date") @db.Date
  status          StudentStatus @default(ACTIVE)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch                Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  enrollments           StudentEnrollment[]
  guardians             StudentGuardian[]
  attendanceRecords     AttendanceRecord[]
  studentLeaves         StudentLeave[]
  homeworkSubmissions   HomeworkSubmission[]
  examMarks             ExamMark[]
  onlineExamSubmissions OnlineExamSubmission[]
  reportCards           ReportCard[]
  studentInvoices       StudentInvoice[]
  infirmaryVisits       InfirmaryVisit[]
  examSeats             ExamSeat[]
  transports            StudentTransport[]
  bookIssues            BookIssue[]
  certificates          IssuedCertificate[]

  @@unique([tenantId, id])
  @@unique([tenantId, admissionNumber])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@map("students")
}

model Parent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  occupation String?   @db.VarChar(128)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  children StudentGuardian[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("parents")
}

model StudentGuardian {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String  @map("student_id") @db.Uuid
  parentId     String  @map("parent_id") @db.Uuid
  relationship String  @db.VarChar(32)
  isPrimary    Boolean @default(false) @map("is_primary")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@map("student_guardians")
}

model StudentEnrollment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  studentId      String @map("student_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  sectionId      String @map("section_id") @db.Uuid
  rollNumber     Int?   @map("roll_number")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
